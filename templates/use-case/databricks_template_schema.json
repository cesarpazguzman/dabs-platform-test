{
  "welcome_message": "Corporate use-case template",
  "properties": {
    "use_case": {
      "type": "string",
      "order": 1,
      "description": "Use-case name (lowercase, no spaces)",
      "pattern": "^[a-z][a-z0-9_]+$",
      "pattern_match_failure_message": "Only lowercase letters, digits and _"
    },
    "github_org": {
      "type": "string",
      "order": 2,
      "default": "cesarpazguzman",
      "description": "GitHub organization (or user)",
      "skip_prompt_if": {}
    },
    "catalog": {
      "type": "string",
      "order": 3,
      "default": "demo_dabs",
      "description": "Catalog",
      "skip_prompt_if": {}
    },
    "qa_sp": {
      "type": "string",
      "order": 4,
      "default": "sp-dabs-qa",
      "description": "Service principal that deploys qa (display name)",
      "skip_prompt_if": {}
    },
    "prd_sp": {
      "type": "string",
      "order": 5,
      "default": "sp-dabs-prd",
      "description": "Service principal that deploys prd (display name)",
      "skip_prompt_if": {}
    }
  },
  "success_message": "\nUse case '{{.use_case}}' created in folder {{.use_case}}/"
}
