name: deploy-{{.use_case}}
on:
  pull_request:
    branches: [qa, main]
    paths: ["{{.use_case}}/**"]
  push:
    branches: [qa, main]   # qa -> qa target, main -> prd target
    paths: ["{{.use_case}}/**"]
jobs:
  ci:
    uses: {{.github_org}}/dabs-platform-test/.github/workflows/bundle-ci.yml@v1
    with:
      bundle_path: {{.use_case}}
    secrets: inherit
